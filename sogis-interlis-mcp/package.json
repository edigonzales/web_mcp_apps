{
  "name": "sogis-interlis-mcp",
  "version": "0.1.0",
  "description": "MCP-Server und MCP-Apps fuer SOGIS INTERLIS ilivalidator und Modelfinder.",
  "type": "module",
  "private": true,
  "bin": {
    "sogis-interlis-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
